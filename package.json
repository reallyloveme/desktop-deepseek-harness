{
  "name": "desktop-deepseek-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness (dsh) Desktop Wrapper - Tauri shell around the official dsh Web UI",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:runtime": "node -e \"const {spawnSync}=require('child_process');const ps=process.platform==='win32';const r=spawnSync(ps?'powershell':'bash',ps?['-ExecutionPolicy','Bypass','-File','scripts/prepare_runtime.ps1']:['scripts/prepare_runtime.sh'],{stdio:'inherit'});process.exit(r.status||0)\"",
    "gen:icon": "node scripts/gen-icon.mjs && tauri icon scripts/icon-source.png -o src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
